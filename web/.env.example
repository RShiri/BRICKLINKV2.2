# Copy to .env.local and fill in from your Supabase project settings
# (Dashboard → Project Settings → API). Safe for the browser once RLS
# is applied (supabase/migrations/0003_rls.sql).
# The key accepts either format: the legacy anon JWT or the new
# sb_publishable_... key. NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY works as
# an alternative name for the same value.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: enables POST /api/revalidate?secret=... for cache busting after ETL runs
REVALIDATE_SECRET=

# Optional: canonical origin for sitemap/robots/OG links (defaults to the Vercel URL)
NEXT_PUBLIC_SITE_URL=
